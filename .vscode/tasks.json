{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make: build app",
      "type": "shell",
      "command": "make app",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "make: build core_test",
      "type": "shell",
      "command": "make core_test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "debug",
      "type": "shell",
      "command": "./debug.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
