{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/core_test",
      "args": ["testdata/add_order_a.bin"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "meson: build core_test"
    },
    {
      "name": "LLDB: core_test",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/core_test",
      "args": ["testdata/add_order_a.bin"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "meson: build core_test"
    },
    {
      "name": "LLDB: app",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "meson: build app"
    },
    {
      "name": "Run App (no debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "./run.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Core Test (no debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "./test_core.sh",
      "cwd": "${workspaceFolder}"
    }
  ]
}
