# --- Makefile build (the build system; meson dropped) ---
build-make/
build-make-release/
compile_commands.json

# --- Vendored databento-cpp (cloned + built locally, see Makefile) ---
vendor/

# --- Compiled artifacts (if they leak outside build/) ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
a.out

# --- Stray single-file IDE runs (use ./run.sh or ./test_core.sh) ---
Core/Source/Core/Core
App/Source/App
core_test

# --- IDE (local machine state) ---
.idea/
.vs/
*.user
*.suo
*.sln.docstates
*.iml

# Shareable editor config is tracked: .vscode/, .clangd

# --- Personal notes (local only) ---
LOCAL_CHEATSHEET.txt
LOCAL_ROADMAP.txt

# Generated benchmark fixture (regen: python3 testdata/gen_big_mix.py)
testdata/big_mix.bin

# --- Cursor / local AI tooling ---
.ai/
.cursor/

# --- Tool caches ---
.cache/
.clangd-index/

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Editor backups ---
*~
*.swp
*.swo
*.bak

# --- Debug / crash dumps ---
*.core
*.dSYM/
bench.trace/
