# --- Build trees (CMake presets; the Makefile is a wrapper around them) ---
build-cmake/
compile_commands.json

# --- Vendored databento-cpp (cloned + built locally, see Makefile) ---
vendor/

# --- Compiled artifacts (if they leak outside build/) ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
a.out

# --- Stray single-file IDE runs (use ./test_core.sh) ---
Core/Source/Core/Core
App/Source/App
core_test

# --- IDE (local machine state) ---
.idea/
.vs/
*.user
*.suo
*.sln.docstates
*.iml

# Shareable editor config is tracked: .vscode/, .clangd

# --- Personal notes (local only) ---
LOCAL_CHEATSHEET.txt
LOCAL_ROADMAP.txt

# Generated benchmark fixture (regen: python3 testdata/gen_big_mix.py)
testdata/big_mix.bin

# --- Cursor / local AI tooling ---
.ai/
.cursor/

# --- Tool caches ---
.cache/
.clangd-index/

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Editor backups ---
*~
*.swp
*.swo
*.bak

# --- Debug / crash dumps ---
*.core
*.dSYM/
bench.trace/

# Queue benchmark fixtures and plotting env (regen: make queue_report)
testdata/queue_*.bin
.venv/

# Databento market data is licensed, never commit it (regen: make mbo_download)
*.dbn
*.dbn.zst
*.depth.csv

benchmarks/reference/profile_sample.txt

# book_bench flows, regenerated by tools/linux/book_bench.sh
benchmarks/linux/flows/

# GoogleTest discovery output (written next to the sources on each build)
cmake_test_discovery_*.json

# Derived from licensed Databento data (decompressed copies and exported order flows)
benchmarks/linux/databento/data/
benchmarks/linux/databento/flows/
